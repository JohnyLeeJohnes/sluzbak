<!-- Okno aplikace. Načítá ho Sluzbak.ps1, takže tu nejsou žádné obsluhy událostí, jen vzhled a jména prvků.
     Karty přehledu dostávají data přes DataContext; názvy vlastností odpovídají objektům z Golemio.ps1. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Službák" Width="1180" Height="780" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <!-- Paleta: noční Praha + pálená hlína. Barva Bg se zrcadlí ve Sluzbak.ps1 (titulkový pruh). -->
        <SolidColorBrush x:Key="Bg" Color="#11141B"/>
        <SolidColorBrush x:Key="Well" Color="#0C0F15"/>
        <SolidColorBrush x:Key="Surface" Color="#191D27"/>
        <SolidColorBrush x:Key="SurfaceHover" Color="#212736"/>
        <SolidColorBrush x:Key="Stroke" Color="#2A3040"/>
        <SolidColorBrush x:Key="StrokeHover" Color="#3A4257"/>
        <SolidColorBrush x:Key="Text" Color="#ECEEF4"/>
        <SolidColorBrush x:Key="Muted" Color="#8C93A8"/>
        <SolidColorBrush x:Key="Accent" Color="#E9A45B"/>
        <SolidColorBrush x:Key="AccentHover" Color="#F0B676"/>
        <SolidColorBrush x:Key="AccentPressed" Color="#D48F47"/>
        <SolidColorBrush x:Key="AccentTint" Color="#1FE9A45B"/>
        <SolidColorBrush x:Key="OnAccent" Color="#1F1405"/>
        <SolidColorBrush x:Key="Danger" Color="#FF8A80"/>

        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3" CornerRadius="13" BorderThickness="2"
                                BorderBrush="{StaticResource Accent}" Opacity="0.8"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MaxWidth" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Úzký posuvník bez šipek -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{StaticResource StrokeHover}" CornerRadius="3" Margin="3,2"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="TextDecorations" Value="{x:Null}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentHover}"/>
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Společná šablona pole; PasswordBox ji používá stejně jako TextBox -->
        <ControlTemplate x:Key="FieldTemplate" TargetType="Control">
            <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}"
                    BorderThickness="1" CornerRadius="10">
                <ScrollViewer x:Name="PART_ContentHost" Margin="11,0" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionOpacity" Value="0.3"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template" Value="{StaticResource FieldTemplate}"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionOpacity" Value="0.3"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template" Value="{StaticResource FieldTemplate}"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource OnAccent}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Accent}" CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}"/>
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="{StaticResource StrokeHover}"
                                BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nenápadná pilulka pro vedlejší akce -->
        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="15" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Popisek nad jedním polem ve skupině -->
        <Style x:Key="FieldCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Zapínací štítek: karta v přehledu ano, nebo ne -->
        <Style x:Key="Chip" TargetType="ToggleButton">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}"
                                BorderThickness="1" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="Mark" FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE73E;"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,1,7,0"
                                           Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrokeHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTint}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nalezené adresy -->
        <Style x:Key="ResultItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <!-- Bez tohohle by čtečka obrazovky místo adresy četla výpis objektu. -->
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="8" Padding="10,8" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentTint}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Karta přehledu -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14,11,14,13"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="CardGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,1,8,0"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CardMeta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="12,1,0,0"/>
        </Style>

        <!-- Stav karty: načítání, prázdno nebo chyba (barvu mění Sluzbak.ps1) -->
        <Style x:Key="CardState" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style x:Key="SubLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>

        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Řádek, který u některých položek chybí: bez textu nezabírá místo. -->
        <Style x:Key="SmallOptional" TargetType="TextBlock" BasedOn="{StaticResource Small}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Barevný štítek s číslem linky -->
        <Style x:Key="RouteBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Záhlaví karty: klik kamkoli do něj kartu sbalí nebo rozbalí, šipka vpravo ukazuje stav -->
        <Style x:Key="CardHeader" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Sbalit nebo rozbalit"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <!-- Průhledné pozadí, aby šlo kliknout i do mezery mezi nadpisem a údajem vpravo. -->
                        <Border Background="Transparent">
                            <DockPanel>
                                <TextBlock x:Name="Chevron" DockPanel.Dock="Right" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                           Foreground="{StaticResource Muted}" Text="&#xE70E;" VerticalAlignment="Center" Margin="10,1,0,0"/>
                                <ContentPresenter/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Pozadí má i kořenový prvek, aby bylo na obrázku okna (-Screenshot). -->
    <Grid Background="{StaticResource Bg}">

        <!-- Nastavení: vlevo klíč a místo, vpravo co a jak ukazovat -->
        <ScrollViewer x:Name="SetupView" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Width="920" Margin="0,14" VerticalAlignment="Center">

                <!-- Značka: oko, které hlídá jedno místo -->
                <Grid Width="56" Height="56" HorizontalAlignment="Center">
                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="18"/>
                    <Ellipse Width="34" Height="34" Stroke="{StaticResource Accent}" StrokeThickness="4"/>
                    <Ellipse Width="12" Height="12" Fill="{StaticResource Accent}"/>
                </Grid>
                <TextBlock Text="Službák" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock Foreground="{StaticResource Muted}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"
                           Text="Doprava, svoz odpadu, ovzduší a místa kolem tebe. Data z pražské platformy Golemio."/>

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="440"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="440"/>
                    </Grid.ColumnDefinitions>

                    <!-- Vlevo to, bez čeho to nejde -->
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Klíč ke Golemio API"/>
                        <PasswordBox x:Name="TokenBox" AutomationProperties.Name="Klíč ke Golemio API"/>
                        <TextBlock Style="{StaticResource Hint}">
                            <Run Text="Klíč dostaneš zdarma po registraci na"/>
                            <Hyperlink x:Name="KeyLink" NavigateUri="https://api.golemio.cz/api-keys">api.golemio.cz/api-keys</Hyperlink><Run Text=". Uloží se zašifrovaný jen v tomhle počítači."/>
                        </TextBlock>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Kde to má hlídat" Margin="0,24,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AddressBox" AutomationProperties.Name="Adresa"/>
                            <Button x:Name="FindButton" Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0">
                                <TextBlock>
                                    <Run FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE721;"/>
                                    <Run Text=" Najít"/>
                                </TextBlock>
                            </Button>
                        </Grid>
                        <ListBox x:Name="ResultsList" Visibility="Collapsed" Margin="0,8,0,0" MaxHeight="150"
                                 Background="{StaticResource Well}" BorderThickness="0" Padding="4"
                                 ItemContainerStyle="{StaticResource ResultItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Nalezené adresy">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ScrollViewer Focusable="False">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Hledaná adresa se pošle službě Nominatim (OpenStreetMap). Jestli nechceš, vyplň souřadnice ručně."/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Zeměpisná šířka"/>
                                <TextBox x:Name="LatitudeBox" AutomationProperties.Name="Zeměpisná šířka"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Zeměpisná délka"/>
                                <TextBox x:Name="LongitudeBox" AutomationProperties.Name="Zeměpisná délka"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Vpravo volby. Všechno má výchozí hodnotu, vyplňovat se tu nic nemusí.
                         Štítky se jmenují <sekce>Chip a pole <volba>Box; Sluzbak.ps1 je podle jmen hledá. -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Co má přehled ukazovat"/>
                        <WrapPanel>
                            <ToggleButton x:Name="TransitChip" Style="{StaticResource Chip}" Content="Odjezdy"/>
                            <ToggleButton x:Name="VehiclesChip" Style="{StaticResource Chip}" Content="Jede kolem"/>
                            <ToggleButton x:Name="WasteChip" Style="{StaticResource Chip}" Content="Svoz odpadu"/>
                            <ToggleButton x:Name="AlertsChip" Style="{StaticResource Chip}" Content="Výluky"/>
                            <ToggleButton x:Name="CarsChip" Style="{StaticResource Chip}" Content="Sdílená auta"/>
                            <ToggleButton x:Name="CyclingChip" Style="{StaticResource Chip}" Content="Cyklosčítač"/>
                            <ToggleButton x:Name="AirChip" Style="{StaticResource Chip}" Content="Ovzduší"/>
                            <ToggleButton x:Name="MicroclimateChip" Style="{StaticResource Chip}" Content="Mikroklima"/>
                            <ToggleButton x:Name="ParkingChip" Style="{StaticResource Chip}" Content="Parkování"/>
                            <ToggleButton x:Name="NearbyChip" Style="{StaticResource Chip}" Content="V okolí"/>
                        </WrapPanel>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Jak daleko hledat (v metrech)" Margin="0,16,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Zastávky"/>
                                <TextBox x:Name="StopsRangeBox" AutomationProperties.Name="Zastávky do (m)"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Tříděný odpad"/>
                                <TextBox x:Name="WasteRangeBox" AutomationProperties.Name="Tříděný odpad do (m)"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Parkoviště"/>
                                <TextBox x:Name="ParkingRangeBox" AutomationProperties.Name="Parkoviště do (m)"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Odjezdy" Margin="0,24,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Kolik jich ukázat"/>
                                <TextBox x:Name="DeparturesBox" AutomationProperties.Name="Počet odjezdů"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldCaption}" Text="Obnovovat po (s)"/>
                                <TextBox x:Name="RefreshBox" AutomationProperties.Name="Obnovovat odjezdy po (s)"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="LimitsHint" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </Grid>

                <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Width="440" Margin="0,20,0,0" Content="Uložit a ukázat přehled"/>
                <TextBlock x:Name="SetupStatus" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource Muted}"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button x:Name="BackButton" Style="{StaticResource QuietButton}" Margin="4,0" Visibility="Collapsed">
                        <TextBlock>
                            <Run FontFamily="Segoe MDL2 Assets" FontSize="9" Text="&#xE72B;"/>
                            <Run Text=" Zpět na přehled"/>
                        </TextBlock>
                    </Button>
                    <Button x:Name="DemoButton" Style="{StaticResource QuietButton}" Margin="4,0" Content="Zkusit s ukázkovými daty"
                            ToolTip="Ukáže přehled pro náměstí Míru s vymyšlenými daty. Nic se neuloží a nikam se nepřipojuje."/>
                    <!-- Jen když Službáka pustila Bránocesta; ukazuje ho Sluzbak.ps1. -->
                    <Button x:Name="SetupGatewayButton" Style="{StaticResource QuietButton}" Margin="4,0" Visibility="Collapsed"
                            ToolTip="Zavře Službáka a otevře Bránocestu." AutomationProperties.Name="Zpět na Bránocestu">
                        <TextBlock>
                            <Run FontFamily="Segoe MDL2 Assets" FontSize="9" Text="&#xE72B;"/>
                            <Run Text=" Bránocesta"/>
                        </TextBlock>
                    </Button>
                </StackPanel>
                <!-- Podle čísla verze člověk pozná, jestli má na GitHubu novější vydání. -->
                <TextBlock x:Name="VersionText" Style="{StaticResource Small}" HorizontalAlignment="Center" Margin="0,16,0,0" Opacity="0.7"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Přehled: záhlaví a pod ním všechny karty ve třech sloupcích -->
        <Grid x:Name="DashboardView" Visibility="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid Margin="20,12,20,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource Accent}"
                               Text="&#xE707;" VerticalAlignment="Center" Margin="0,2,10,0"/>
                    <StackPanel>
                        <TextBlock x:Name="PlaceText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                        <TextBlock x:Name="CoordinatesText" Style="{StaticResource Small}"/>
                    </StackPanel>
                    <Border x:Name="DemoBadge" Visibility="Collapsed" Background="{StaticResource AccentTint}"
                            BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="11" Padding="10,2"
                            Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ukázková data" FontSize="12" Foreground="{StaticResource Accent}"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="UpdatedText" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="RefreshButton" Style="{StaticResource QuietButton}" Margin="0,0,8,0"
                            ToolTip="Odjezdy a vozidla se načtou hned, ostatní data nejvýš jednou za 10 minut (F5)">
                        <TextBlock>
                            <Run FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE72C;"/>
                            <Run Text=" Obnovit"/>
                        </TextBlock>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource QuietButton}">
                        <TextBlock>
                            <Run FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE713;"/>
                            <Run Text=" Nastavení"/>
                        </TextBlock>
                    </Button>
                    <Button x:Name="GatewayButton" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Visibility="Collapsed"
                            ToolTip="Zavře Službáka a otevře Bránocestu." AutomationProperties.Name="Zpět na Bránocestu">
                        <TextBlock>
                            <Run FontFamily="Segoe MDL2 Assets" FontSize="10" Text="&#xE72B;"/>
                            <Run Text=" Bránocesta"/>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Posuvník má místo vyhrazené pořád, aby karty neposkočily, když se objeví. -->
            <ScrollViewer x:Name="DashboardScroll" Grid.Row="1" VerticalScrollBarVisibility="Visible" Focusable="False">
                <!-- Sloupce se jmenují Column1 až 3 a karty <sekce>Card; prázdný sloupec okno zavře. Záhlaví karty
                     <sekce>Toggle ji sbaluje a rozbaluje. Nahoře je to hlavní, dole to, co se načítá až po něm. -->
                <Grid x:Name="DashboardGrid" Margin="20,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.12*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="Column1">
                        <Border x:Name="TransitCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <ToggleButton x:Name="TransitToggle" Style="{StaticResource CardHeader}" IsChecked="True" AutomationProperties.Name="Odjezdy">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE806;"/>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Odjezdy"/>
                                        <TextBlock x:Name="TransitMeta" Style="{StaticResource CardMeta}"/>
                                    </DockPanel>
                                </ToggleButton>
                                <TextBlock x:Name="TransitState" Style="{StaticResource CardState}"/>
                                <StackPanel x:Name="TransitBody" Visibility="Collapsed" Margin="0,10,0,0">
                                    <ItemsControl ItemsSource="{Binding Departures}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,7" Opacity="{Binding Opacity}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="48"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource RouteBadge}" Background="{Binding Color}" Height="26">
                                                        <TextBlock Text="{Binding Route}" Foreground="{Binding RouteTextColor}" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Headsign}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Stop}" Style="{StaticResource Small}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding In}" Foreground="{Binding InColor}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                        <TextBlock Style="{StaticResource Small}" HorizontalAlignment="Right">
                                                            <Run Text="{Binding Time, Mode=OneWay}"/>
                                                            <Run Text="{Binding Delay, Mode=OneWay}" Foreground="{StaticResource Accent}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Infotexts}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource Well}" CornerRadius="8" Padding="10,7" Margin="0,2,0,0">
                                                    <DockPanel>
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource Accent}"
                                                                   Text="&#xE7BA;" Margin="0,2,8,0" VerticalAlignment="Top"/>
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="VehiclesCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <ToggleButton x:Name="VehiclesToggle" Style="{StaticResource CardHeader}" IsChecked="True" AutomationProperties.Name="Právě jede kolem">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE7C0;"/>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Právě jede kolem"/>
                                        <TextBlock x:Name="VehiclesMeta" Style="{StaticResource CardMeta}"/>
                                    </DockPanel>
                                </ToggleButton>
                                <TextBlock x:Name="VehiclesState" Style="{StaticResource CardState}"/>
                                <StackPanel x:Name="VehiclesBody" Visibility="Collapsed" Margin="0,4,0,0">
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="44"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto" MinWidth="46"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource RouteBadge}" Background="{Binding Color}">
                                                        <TextBlock Text="{Binding Route}" Foreground="{Binding RouteTextColor}" FontSize="12" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Headsign, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text="{Binding State, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" Text="{Binding Delay}" Foreground="{StaticResource Accent}" FontSize="11.5"
                                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Distance}" Style="{StaticResource Small}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="Column2" Grid.Column="2">
                        <Border x:Name="WasteCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <ToggleButton x:Name="WasteToggle" Style="{StaticResource CardHeader}" IsChecked="True" AutomationProperties.Name="Svoz odpadu">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE74D;"/>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Svoz odpadu"/>
                                        <TextBlock x:Name="WasteMeta" Style="{StaticResource CardMeta}"/>
                                    </DockPanel>
                                </ToggleButton>
                                <TextBlock x:Name="WasteState" Style="{StaticResource CardState}"/>
                                <StackPanel x:Name="WasteBody" Visibility="Collapsed" Margin="0,10,0,0">
                                    <ItemsControl ItemsSource="{Binding Stations}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,12">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Distance}" Style="{StaticResource Small}"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <ItemsControl ItemsSource="{Binding Kinds}" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,5,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="17"/>
                                                                        <ColumnDefinition/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto" MinWidth="62"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Ellipse Width="9" Height="9" Fill="{Binding Color}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                        <Run Text="{Binding Type, Mode=OneWay}"/>
                                                                        <Run Text="{Binding PickDays, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                                                                    </TextBlock>
                                                                    <TextBlock Grid.Column="2" Text="{Binding Fill}" Style="{StaticResource Small}" VerticalAlignment="Center"
                                                                               Margin="8,0,0,0" ToolTip="Jak je kontejner plný podle senzoru"/>
                                                                    <TextBlock Grid.Column="3" Text="{Binding Next}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                                               VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Příští svoz"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Klíč bez přístupu k velkoobjemovým kontejnerům: nadpis se schová, seznam i poznámka jsou prázdné. -->
                                    <TextBlock Text="Velkoobjemové kontejnery">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SubLabel}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowBulky}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Bulky}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,5,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Distance}" Style="{StaticResource Small}"
                                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding When, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text="{Binding Street, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                                                    </TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding BulkyNote}" Style="{StaticResource SmallOptional}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="AlertsCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <ToggleButton x:Name="AlertsToggle" Style="{StaticResource CardHeader}" IsChecked="True" AutomationProperties.Name="Výluky a mimořádnosti">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE7BA;"/>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Výluky a mimořádnosti"/>
                                        <TextBlock x:Name="AlertsMeta" Style="{StaticResource CardMeta}"/>
                                    </DockPanel>
                                </ToggleButton>
                                <TextBlock x:Name="AlertsState" Style="{StaticResource CardState}"/>
                                <StackPanel x:Name="AlertsBody" Visibility="Collapsed" Margin="0,2,0,0">
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,8,0,0" ToolTip="{Binding Text}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="11"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="3" CornerRadius="1.5" Background="{Binding Color}" HorizontalAlignment="Left"/>
                                                    <StackPanel Grid.Column="1">
                                                        <!-- Dva řádky; celý text je v bublině po najetí myší. -->
                                                        <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="33"/>
                                                        <TextBlock Style="{StaticResource Small}" Margin="0,1,0,0">
                                                            <Run Text="{Binding Stops, Mode=OneWay}"/>
                                                            <Run Text="{Binding Until, Mode=OneWay}" Foreground="{StaticResource Text}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding More}" Style="{StaticResource SmallOptional}" Margin="11,7,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CarsCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <ToggleButton x:Name="CarsToggle" Style="{StaticResource CardHeader}" IsChecked="True" AutomationProperties.Name="Sdílená auta">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE811;"/>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Sdílená auta"/>
                                        <TextBlock x:Name="CarsMeta" Style="{StaticResource CardMeta}"/>
                                    </DockPanel>
                                </ToggleButton>
                                <TextBlock x:Name="CarsState" Style="{StaticResource CardState}"/>
                                <StackPanel x:Name="CarsBody" Visibility="Collapsed" Margin="0,3,0,0">
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,6,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Distance}" Style="{StaticResource Small}"
                                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                                                    </TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="CyclingCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <ToggleButton x:Name="CyclingToggle" Style="{StaticResource CardHeader}" IsChecked="True" AutomationProperties.Name="Cyklosčítač">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE9D2;"/>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Cyklosčítač"/>
                                        <TextBlock x:Name="CyclingMeta" Style="{StaticResource CardMeta}"/>
                                    </DockPanel>
                                </ToggleButton>
                                <TextBlock x:Name="CyclingState" Style="{StaticResource CardState}"/>
                                <StackPanel x:Name="CyclingBody" Visibility="Collapsed" Margin="0,8,0,0">
                                    <TextBlock>
                                        <Run Text="{Binding Total, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/>
                                        <Run Text="{Binding Caption, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,5,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="Column3" Grid.Column="4">
                        <Border x:Name="AirCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <ToggleButton x:Name="AirToggle" Style="{StaticResource CardHeader}" IsChecked="True" AutomationProperties.Name="Ovzduší">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE753;"/>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Ovzduší"/>
                                        <TextBlock x:Name="AirMeta" Style="{StaticResource CardMeta}"/>
                                    </DockPanel>
                                </ToggleButton>
                                <TextBlock x:Name="AirState" Style="{StaticResource CardState}"/>
                                <StackPanel x:Name="AirBody" Visibility="Collapsed" Margin="0,10,0,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Updated}" Style="{StaticResource Small}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        <Border Background="{Binding IndexColor}" CornerRadius="8" Padding="11,5" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Index}" Foreground="{Binding IndexTextColor}" FontSize="14" FontWeight="SemiBold"/>
                                        </Border>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Components}" Focusable="False" Margin="0,3,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,6,0,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold"
                                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="48" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="MicroclimateCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <ToggleButton x:Name="MicroclimateToggle" Style="{StaticResource CardHeader}" IsChecked="True" AutomationProperties.Name="Mikroklima">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE706;"/>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Mikroklima"/>
                                        <TextBlock x:Name="MicroclimateMeta" Style="{StaticResource CardMeta}"/>
                                    </DockPanel>
                                </ToggleButton>
                                <TextBlock x:Name="MicroclimateState" Style="{StaticResource CardState}"/>
                                <StackPanel x:Name="MicroclimateBody" Visibility="Collapsed" Margin="0,4,0,0">
                                    <ItemsControl ItemsSource="{Binding Values}" Focusable="False" Margin="0,0,-14,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,6,14,0">
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Updated}" Style="{StaticResource Small}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ParkingCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <ToggleButton x:Name="ParkingToggle" Style="{StaticResource CardHeader}" IsChecked="True" AutomationProperties.Name="Parkování">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE804;"/>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Parkování"/>
                                        <TextBlock x:Name="ParkingMeta" Style="{StaticResource CardMeta}"/>
                                    </DockPanel>
                                </ToggleButton>
                                <TextBlock x:Name="ParkingState" Style="{StaticResource CardState}"/>
                                <StackPanel x:Name="ParkingBody" Visibility="Collapsed" Margin="0,3,0,0">
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,6,0,0">
                                                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <Run Text="{Binding Free, Mode=OneWay}" Foreground="{Binding FreeColor}" FontWeight="SemiBold"/>
                                                        <Run Text="{Binding Capacity, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                                                    </TextBlock>
                                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="11.5"/>
                                                    </TextBlock>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Machine}" Style="{StaticResource SmallOptional}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="NearbyCard" Style="{StaticResource Card}">
                            <StackPanel>
                                <ToggleButton x:Name="NearbyToggle" Style="{StaticResource CardHeader}" IsChecked="True" AutomationProperties.Name="V okolí">
                                    <DockPanel>
                                        <TextBlock Style="{StaticResource CardGlyph}" Text="&#xE81D;"/>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="V okolí"/>
                                        <TextBlock x:Name="NearbyMeta" Style="{StaticResource CardMeta}"/>
                                    </DockPanel>
                                </ToggleButton>
                                <TextBlock x:Name="NearbyState" Style="{StaticResource CardState}"/>
                                <StackPanel x:Name="NearbyBody" Visibility="Collapsed" Margin="0,2,0,0">
                                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <!-- Dva řádky; adresa a otevírací doba celým textem jsou v bublině. -->
                                                <StackPanel Margin="0,8,0,0" ToolTip="{Binding Detail}" Background="Transparent">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Distance}" Style="{StaticResource Small}"
                                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                                                   FontSize="11.5" FontWeight="SemiBold" Margin="10,0,0,0"/>
                                                        <TextBlock Style="{StaticResource Small}">
                                                            <Run Text="{Binding Kind, Mode=OneWay}" FontWeight="SemiBold"/>
                                                            <Run Text="{Binding Address, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </DockPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
